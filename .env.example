# Saleor
NEXT_PUBLIC_SALEOR_API_URL=
SALEOR_APP_TOKEN=

# ERPNext
ERPNEXT_API_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Strapi
STRAPI_API_URL=
STRAPI_API_TOKEN=
STRAPI_PREVIEW_TOKEN=
STRAPI_REVALIDATE_SECRET=

# Wizzy (per-environment: staging or production)
WIZZY_ENV=staging
WIZZY_API_URL=
WIZZY_API_KEY=
WIZZY_PROJECT_ID=

# Google Maps
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLEVERTAP_ACCOUNT_ID=

# Google Tag Manager — single container ID across environments; the TEST
# GTM environment is targeted by setting auth + preview together. GA4
# measurement IDs (G-XYZ prod / G-J717XBYYH0 test) live INSIDE GTM,
# not here.
NEXT_PUBLIC_GTM_ID=GTM-KDR6N28Q
# Leave both UNSET in production:
#   PROD →  AUTH=                         PREVIEW=
#   TEST →  AUTH=LFqR_9j4YF5nxuaI5ylU2A   PREVIEW=env-5
NEXT_PUBLIC_GTM_AUTH=
NEXT_PUBLIC_GTM_PREVIEW=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Smart app-download redirect (device-aware: App Store vs Play Store).
# Drives the header + footer "Download App" CTAs and both store badges.
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://api.stage.freshterra.in/app?source=website

# Lead capture (Coming Soon /notify form)
# The /notify form posts directly to Web3Forms from the browser. Get an
# access key at https://web3forms.com — it's a public key, safe to ship.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optional overrides — leave UNSET (don't set to empty) to keep the defaults
# (https://api.web3forms.com/submit, 15000 ms). Uncomment only if self-hosting:
#   NEXT_PUBLIC_WEB3FORMS_SUBMIT_URL=https://api.web3forms.com/submit
#   NEXT_PUBLIC_WEB3FORMS_TIMEOUT_MS=15000

# Optional secondary lead destinations (server-side, used by /api/leads if
# you re-enable a server-relay path). Leave unset for browser-only Web3Forms.
LEAD_WEBHOOK_URL=
LEAD_FRESHTERRA_API_URL=
LEAD_FRESHTERRA_API_KEY=
